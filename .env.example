# Gym Tracker — environment variables
# Copy this file to ".env.local" and fill in your Supabase project values.
# Get them from: https://supabase.com/dashboard → Project Settings → API
#
#   cp .env.example .env.local       (mac/linux)
#   copy .env.example .env.local     (windows)

# Your Supabase project URL (looks like https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Your Supabase anon public key (long JWT starting with "eyJ...")
# This key is meant to be public — it's safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...paste-your-anon-key-here...

# Optional: build-time override of the manifest theme color (defaults to #0a0a0a)
# NEXT_PUBLIC_THEME_COLOR=#0a0a0a
